RewriteEngine On
RewriteBase /sports-portal/

# SEO Friendly URLs for News
RewriteRule ^news/([^/]+)/?$ news/index.php?slug=$1 [L,QSA]

# SEO Friendly URLs for Categories
RewriteRule ^category/([^/]+)/?$ category/index.php?slug=$1 [L,QSA]

# SEO Friendly URLs for Match Center
RewriteRule ^match-center/([^/]+)/?$ match-center/index.php?id=$1 [L,QSA]

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
